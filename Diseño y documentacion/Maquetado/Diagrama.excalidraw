      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "li.taskItem\nflex\nrow\nbeetwen/space/around\ncontent: \n    <div.mainTask>\n        <icono.iconoTitleTask>\n        <h2.titleh2>Titulo tarea</h2>\n    </div>\n    <div.detailsTask>\n            <icono.iconoDetails> (opcional)\n           <button>Detalles</detalles>\n    </div>\n\n    <div.controlsRootTask>\n        <button><icono.iconoPause></button>\n        <button><icono.iconoEdit></button>\n        <button><icono.iconoDelete></button>           \n    </div>\n    \n",
